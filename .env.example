# Copy to .env for local development (never commit secrets)
POSTGRES_USER=regulatory
POSTGRES_PASSWORD=regulatory
POSTGRES_DB=regulatory_augsys
DATABASE_URL=postgresql+psycopg://regulatory:regulatory@localhost:5432/regulatory_augsys

# SQLite fallback (no Docker): uncomment and use instead of DATABASE_URL above
# DATABASE_URL=sqlite:///./data/regulatory_augsys.db

API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain
DATA_GOVERNANCE_ALLOW_EXTERNAL=false
