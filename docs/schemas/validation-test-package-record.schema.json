{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/usp1904/Regulatory-AugSys/docs/schemas/validation-test-package-record.schema.json",
  "title": "Validation Test Package Record",
  "description": "Structured draft validation test cases and traceability for CSV/GAMP contexts. Not executed test evidence or qualification sign-off.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "status",
    "testPhase",
    "systemUnderTest",
    "testCases",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "maras.validation-test-package.v1"
    },
    "recordId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "needs-review", "reviewer-approved", "rejected"]
    },
    "testPhase": {
      "type": "string",
      "enum": ["iq", "oq", "pq", "combined", "regression", "smoke", "custom"]
    },
    "systemUnderTest": {
      "$ref": "#/$defs/systemUnderTest"
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/testCase" }
    },
    "traceability": {
      "type": "array",
      "items": { "$ref": "#/$defs/traceRow" }
    },
    "environmentRequirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "upstreamRefs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authoringRecordId": { "type": ["string", "null"] },
        "evidenceRecordId": { "type": ["string", "null"] },
        "changeImpactRecordId": { "type": ["string", "null"] },
        "marasPbiIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "testCaseCount": { "type": "integer", "minimum": 0 },
        "positiveCount": { "type": "integer", "minimum": 0 },
        "negativeCount": { "type": "integer", "minimum": 0 },
        "requirementsCovered": { "type": "integer", "minimum": 0 },
        "requirementsGapped": { "type": "integer", "minimum": 0 }
      }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "uncertainties": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reviewerActionNeeded": {
      "type": "array",
      "items": { "type": "string" }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packageStatus": {
          "type": "string",
          "const": "DRAFT_NOT_CONTROLLED"
        },
        "executed": { "type": "boolean", "const": false },
        "passed": { "type": "boolean", "const": false }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "systemUnderTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systemId", "systemName"],
      "properties": {
        "systemId": { "type": "string", "minLength": 1 },
        "systemName": { "type": "string", "minLength": 1 },
        "gampCategory": {
          "type": ["string", "null"],
          "enum": ["1", "2", "3", "4", "5", null]
        },
        "environmentNotes": { "type": ["string", "null"] }
      }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testId",
        "title",
        "objective",
        "testType",
        "steps",
        "requirementRefs"
      ],
      "properties": {
        "testId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "title": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "testType": {
          "type": "string",
          "enum": ["positive", "negative", "edge-case"]
        },
        "preconditions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/testStep" }
        },
        "requirementRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "sourceEvidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "citation": { "type": ["string", "null"] },
            "verbatimExcerpt": { "type": ["string", "null"] },
            "evidenceClaimId": { "type": ["string", "null"] },
            "marasPbiId": { "type": ["string", "null"] }
          }
        },
        "reviewFlags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "machine-generated",
              "needs-sme-review",
              "missing-negative-coverage",
              "environment-not-defined",
              "dual-signoff-required",
              "regulatory-citation-required"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "testStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepNumber", "action", "expectedObservation"],
      "properties": {
        "stepNumber": { "type": "integer", "minimum": 1 },
        "action": { "type": "string", "minLength": 1 },
        "expectedObservation": { "type": "string", "minLength": 1 }
      }
    },
    "traceRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementRef", "coverageStatus"],
      "properties": {
        "requirementRef": { "type": "string", "minLength": 1 },
        "linkedTestIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "coverageStatus": {
          "type": "string",
          "enum": ["proposed", "gap", "needs-review"]
        },
        "notes": { "type": ["string", "null"] }
      }
    }
  }
}
