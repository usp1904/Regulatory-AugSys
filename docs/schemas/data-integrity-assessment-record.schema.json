{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/usp1904/Regulatory-AugSys/docs/schemas/data-integrity-assessment-record.schema.json",
  "title": "Data Integrity Assessment Record",
  "description": "ALCOA+ oriented assessment of record metadata and provenance. Not a compliance certification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "status",
    "assessmentSubject",
    "principles",
    "overallRisk",
    "assessedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "maras.data-integrity-assessment.v1"
    },
    "recordId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "needs-review", "reviewer-approved", "rejected"]
    },
    "assessmentSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subjectRef"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "evidence-record",
            "intake-record",
            "comparison-record",
            "ctd-mapping-record",
            "document-review-record",
            "maras-pbi",
            "derived-artifact",
            "controlled-document",
            "custom"
          ]
        },
        "subjectRef": { "type": "string", "minLength": 1 },
        "label": { "type": ["string", "null"] }
      }
    },
    "principles": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/principleResult" }
    },
    "overallRisk": {
      "type": "string",
      "enum": ["low", "medium", "high", "unknown"]
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "uncertainties": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reviewerActionNeeded": {
      "type": "array",
      "items": { "type": "string" }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "originalImmutable": { "type": ["boolean", "null"] },
        "derivedSeparated": { "type": ["boolean", "null"] },
        "packageStatus": { "type": "string", "const": "DRAFT_NOT_CONTROLLED" }
      }
    },
    "assessedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "principleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principle", "result", "statement"],
      "properties": {
        "principle": {
          "type": "string",
          "enum": [
            "attributable",
            "legible",
            "contemporaneous",
            "original",
            "accurate",
            "complete",
            "consistent",
            "enduring",
            "available"
          ]
        },
        "result": {
          "type": "string",
          "enum": ["pass", "fail", "needs-review", "na"]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidenceRef": { "type": ["string", "null"] },
        "gap": { "type": ["string", "null"] }
      }
    }
  }
}
